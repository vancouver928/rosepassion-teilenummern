{
  "manifest_version": 3,
  "name": "Teilenummern-Anzeige für rosepassion.com",
  "version": "1.3",
  "description": "Zeigt auf rosepassion.com die Porsche-Teilenummern direkt in der Teileliste. Klick kopiert die Nummer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rosepassion.com/*",
        "https://rosepassion.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teilenummern-Anzeige",
    "default_icon": {
      "16": "icons/icon16-grey.png",
      "32": "icons/icon32-grey.png",
      "48": "icons/icon48-grey.png",
      "128": "icons/icon128-grey.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}